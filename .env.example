# Scale Simulator - exemplo de configuração local
# Não altera a porta padrão do Tauri em desenvolvimento (src-tauri/tauri.conf.json: 1420).

# Primeiro acesso headless (não grave valores reais no repositório)
SCALE_SIMULATOR_BOOTSTRAP_ADMIN_USERNAME=admin
SCALE_SIMULATOR_BOOTSTRAP_ADMIN_PASSWORD=

SCALE_SIMULATOR_API_HOST=127.0.0.1
SCALE_SIMULATOR_API_PORT=61001
SCALE_SIMULATOR_API_AUTO_START=true
SCALE_SIMULATOR_API_BASE_URL=http://127.0.0.1:61001
SCALE_SIMULATOR_API_SCALAR_ENABLED=true
SCALE_SIMULATOR_API_SCALAR_URL=http://127.0.0.1:61001/docs
SCALE_SIMULATOR_API_DOCS_PATH=/docs
SCALE_SIMULATOR_API_DOCS_PUBLIC_LOCAL=true
SCALE_SIMULATOR_API_RESTART_ON_CONFIG_CHANGE=true
SCALE_SIMULATOR_API_OPEN_SCALAR_AFTER_START=false
SCALE_SIMULATOR_API_TIMEOUT_MS=8000
SCALE_SIMULATOR_API_LOG_MODE=normal
SCALE_SIMULATOR_API_ALLOW_PUBLIC_NETWORK=false
SCALE_SIMULATOR_API_REQUIRE_TOKEN=false
SCALE_SIMULATOR_API_TOKEN=
SCALE_SIMULATOR_API_TOKEN_HEADER=X-App-Token

SCALE_SIMULATOR_WEB_ENABLED=true
SCALE_SIMULATOR_WEB_HOST=127.0.0.1
SCALE_SIMULATOR_WEB_PORT=61002
SCALE_SIMULATOR_WEB_AUTO_START=true
SCALE_SIMULATOR_WEB_BIND_LAN=false

SCALE_SIMULATOR_WEBHOOK_ENABLED=false
SCALE_SIMULATOR_WEBHOOK_AUTO_START=false
SCALE_SIMULATOR_WEBHOOK_HOST=127.0.0.1
SCALE_SIMULATOR_WEBHOOK_PORT=61003
SCALE_SIMULATOR_WEBHOOK_BASE_PATH=/webhooks
SCALE_SIMULATOR_WEBHOOK_TOKEN_REQUIRED=true
SCALE_SIMULATOR_WEBHOOK_TOKEN_HEADER=X-Webhook-Token
SCALE_SIMULATOR_WEBHOOK_TOKEN=
SCALE_SIMULATOR_WEBHOOK_ALLOW_LAN=false
SCALE_SIMULATOR_WEBHOOK_ALLOW_EXTERNAL=false

SCALE_SIMULATOR_WEBSOCKET_ENABLED=false
SCALE_SIMULATOR_WEBSOCKET_AUTO_START=false
SCALE_SIMULATOR_WEBSOCKET_HOST=127.0.0.1
SCALE_SIMULATOR_WEBSOCKET_PORT=61004
SCALE_SIMULATOR_WEBSOCKET_PATH=/ws
SCALE_SIMULATOR_WEBSOCKET_TOKEN_REQUIRED=true
SCALE_SIMULATOR_WEBSOCKET_TOKEN_QUERY=token
SCALE_SIMULATOR_WEBSOCKET_TOKEN_HEADER=X-WebSocket-Token
SCALE_SIMULATOR_WEBSOCKET_TOKEN=
SCALE_SIMULATOR_WEBSOCKET_ALLOW_LAN=false
SCALE_SIMULATOR_WEBSOCKET_ALLOW_EXTERNAL=false
SCALE_SIMULATOR_WEBSOCKET_HEARTBEAT_SECONDS=30

SCALE_SIMULATOR_TRAY_ENABLED=true
SCALE_SIMULATOR_TRAY_MINIMIZE_TO_TRAY=true
SCALE_SIMULATOR_TRAY_CLOSE_TO_TRAY=false
SCALE_SIMULATOR_START_WITH_WINDOWS=false
SCALE_SIMULATOR_SERVICES_AUTO_START=false
