# Scale Simulator CloudPanel / Linux Headless - portas publicadas
# Copie para .env somente quando quiser liberar as portas diretamente no servidor.
# Atenção: configure firewall, tokens e proxy reverso antes de expor em produção.

SCALE_SIMULATOR_PUBLISH_ALL_PORTS=true
SCALE_SIMULATOR_START_ALL_PORTS=true
SCALE_SIMULATOR_RESPECT_CLOUDPANEL_PORT=false
SCALE_SIMULATOR_PUBLIC_BIND_HOST=0.0.0.0

SCALE_SIMULATOR_API_HOST=0.0.0.0
SCALE_SIMULATOR_API_PORT=61001
SCALE_SIMULATOR_API_AUTO_START=true
SCALE_SIMULATOR_API_BASE_URL=http://127.0.0.1:61001
SCALE_SIMULATOR_API_SCALAR_ENABLED=true
SCALE_SIMULATOR_API_SCALAR_URL=http://127.0.0.1:61001/docs
SCALE_SIMULATOR_API_DOCS_PATH=/docs
SCALE_SIMULATOR_API_DOCS_PUBLIC_LOCAL=false
SCALE_SIMULATOR_API_REQUIRE_TOKEN=true
SCALE_SIMULATOR_API_ALLOW_PUBLIC_NETWORK=true
SCALE_SIMULATOR_API_CORS=true
SCALE_SIMULATOR_API_TOKEN_HEADER=X-App-Token
SCALE_SIMULATOR_API_TOKEN=troque-este-token-api

SCALE_SIMULATOR_WEB_ENABLED=true
SCALE_SIMULATOR_WEB_HOST=0.0.0.0
SCALE_SIMULATOR_WEB_PORT=61002
SCALE_SIMULATOR_WEB_AUTO_START=true
SCALE_SIMULATOR_WEB_BIND_LAN=true
SCALE_SIMULATOR_WEB_DIST_DIR=./dist

SCALE_SIMULATOR_SERVICES_AUTO_START=true
SCALE_SIMULATOR_WEBHOOK_ENABLED=true
SCALE_SIMULATOR_WEBHOOK_AUTO_START=true
SCALE_SIMULATOR_WEBHOOK_HOST=0.0.0.0
SCALE_SIMULATOR_WEBHOOK_PORT=61003
SCALE_SIMULATOR_WEBHOOK_BASE_PATH=/webhooks
SCALE_SIMULATOR_WEBHOOK_TOKEN_REQUIRED=true
SCALE_SIMULATOR_WEBHOOK_TOKEN_HEADER=X-Webhook-Token
SCALE_SIMULATOR_WEBHOOK_TOKEN=troque-este-token-webhook
SCALE_SIMULATOR_WEBHOOK_ALLOW_LAN=true
SCALE_SIMULATOR_WEBHOOK_ALLOW_EXTERNAL=true

SCALE_SIMULATOR_WEBSOCKET_ENABLED=true
SCALE_SIMULATOR_WEBSOCKET_AUTO_START=true
SCALE_SIMULATOR_WEBSOCKET_HOST=0.0.0.0
SCALE_SIMULATOR_WEBSOCKET_PORT=61004
SCALE_SIMULATOR_WEBSOCKET_PATH=/ws
SCALE_SIMULATOR_WEBSOCKET_TOKEN_REQUIRED=true
SCALE_SIMULATOR_WEBSOCKET_TOKEN_QUERY=token
SCALE_SIMULATOR_WEBSOCKET_TOKEN_HEADER=X-WebSocket-Token
SCALE_SIMULATOR_WEBSOCKET_TOKEN=troque-este-token-websocket
SCALE_SIMULATOR_WEBSOCKET_ALLOW_LAN=true
SCALE_SIMULATOR_WEBSOCKET_ALLOW_EXTERNAL=true
SCALE_SIMULATOR_WEBSOCKET_HEARTBEAT_SECONDS=30

SCALE_SIMULATOR_BINARY=./bin/scale_simulator_tauri
SCALE_SIMULATOR_DATA_DIR=./data
SCALE_SIMULATOR_LOGS_DIR=./logs
SCALE_SIMULATOR_ENV_FILE=./.env

SCALE_SIMULATOR_TRAY_ENABLED=false
SCALE_SIMULATOR_TRAY_MINIMIZE_TO_TRAY=false
SCALE_SIMULATOR_TRAY_CLOSE_TO_TRAY=false
SCALE_SIMULATOR_START_WITH_WINDOWS=false
SCALE_SIMULATOR_SERVICE_NAME=ScaleSimulatorServer
