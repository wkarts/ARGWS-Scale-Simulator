{
  "name": "scale-simulator",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 61002",
    "build": "npm run build:web",
    "preview": "vite preview",
    "tauri": "node ./scripts/ci/run-tauri.mjs",
    "tauri:dev": "npm run tauri -- dev",
    "tauri:build": "npm run tauri -- build",
    "tauri:build:debug": "npm run tauri -- build --debug",
    "tauri:bundle:mac": "npm run tauri -- bundle --bundles app,dmg",
    "build:web": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "ci:version": "node ./scripts/ci/check-version-sync.mjs",
    "ci:pr-title": "node ./scripts/ci/validate-pr-title.mjs",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "release:ci": "node ./scripts/release/run-semantic-release.mjs",
    "release:dry": "semantic-release --dry-run",
    "tauri:server": "cargo run --locked --manifest-path src-tauri/Cargo.toml -- --mode=headless-api",
    "tauri:cli": "cargo run --locked --manifest-path src-tauri/Cargo.toml -- --mode=cli",
    "tauri:worker": "cargo run --locked --manifest-path src-tauri/Cargo.toml -- --mode=worker",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "ci:rust:features": "cargo build --locked --manifest-path src-tauri/Cargo.toml --features mysql-db && cargo build --locked --manifest-path src-tauri/Cargo.toml --features postgres-db && cargo build --locked --manifest-path src-tauri/Cargo.toml --features mysql-db,postgres-db",
    "validate:rust": "npm run fmt:rust && npm run fmt:rust:check && npm run lint:rust && npm run test:rust && npm run ci:rust:features",
    "validate:web": "npm run ci:version && npm run ci:tauri && npm run typecheck && npm run build:web",
    "validate:all": "npm run validate:web && npm run validate:rust",
    "build:pwa": "npm run build:web",
    "dev:web": "vite --host 127.0.0.1 --port 61002",
    "dev:web:lan": "vite --host 0.0.0.0 --port 61002",
    "dev:tauri": "vite --host 127.0.0.1 --port 1420",
    "ci:tauri": "node ./scripts/ci/check-tauri-versions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vue-tsc": "^2.2.12",
    "semantic-release": "^25.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1"
  },
  "license": "UNLICENSED"
}
